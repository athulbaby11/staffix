# Copy this file to `.env` and fill in real values before deploying.
# `.env` itself must never be committed to version control.

# A long, random, secret string. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-this-with-a-real-secret-key

# Set to false in production.
DJANGO_DEBUG=true

# Comma-separated list of domains/IPs this site will be served from, e.g.:
# DJANGO_ALLOWED_HOSTS=staffix.example.com,www.staffix.example.com
DJANGO_ALLOWED_HOSTS=

# Where automatic database/media backups are written. Defaults to ./backups
# DJANGO_BACKUP_DIR=/var/backups/staffix

# How many recent backups to keep (older ones are pruned automatically).
# DJANGO_BACKUP_RETENTION_COUNT=30

# Whether to force HTTPS redirects (only applies when DJANGO_DEBUG=false).
# DJANGO_SECURE_SSL_REDIRECT=true

# Origins trusted for CSRF (with scheme), e.g. https://staffix.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=

# Persistent locations for the SQLite DB and uploaded files (CVs, DBS, IDs).
# DJANGO_DB_PATH=/var/lib/staffix/db.sqlite3
# DJANGO_MEDIA_ROOT=/var/lib/staffix/media

# SMTP email (console backend is used if not set).
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_EMAIL_USE_TLS=true
# DJANGO_DEFAULT_FROM_EMAIL=staffixrecruit@gmail.com
